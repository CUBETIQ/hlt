# Server endpoints
TRUSTED_HOST=localhost:3000
TRUSTED_SECRET=
PORT=3000

# Log every proxied request (off by default: it is on the hot tunnel path)
REQUEST_LOG=false

# Unified Security
# NODE_ENV=production refuses to start unless SECRET_KEY, ADMIN_PASSWORD and
# ADMIN_JWT_SECRET are all set explicitly.
SECRET_KEY=hlt_default_secret_key_change_me
VERIFY_TOKEN=
# true = anyone can mint a tunnel token from /api/token.
# Defaults to false under NODE_ENV=production; set SERVER_API_KEY when false.
PUBLIC_TOKEN_REGISTRATION=true
SERVER_API_KEY=

# Admin API (separate trust domain — must NOT reuse SECRET_KEY)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_JWT_SECRET=hlt_admin_jwt_secret
ADMIN_JWT_EXPIRES_IN=24h

# Telemetry / Redis
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0

# Public tunnel URLs
# Two layouts. Leave TUNNEL_DOMAIN empty for legacy behaviour (whatever host the
# client dialled becomes its tunnel, locked to that client id).
#
#   subdomain  root domain example.com, cluster on hlt-sg1.example.com
#              TUNNEL_DOMAIN=example.com  TUNNEL_FORMAT=subdomain
#              -> https://<name>.example.com     (needs *.example.com DNS)
#
#   prefix     root domain lt.example.com, cluster on lt.example.com
#              TUNNEL_DOMAIN=lt.example.com  TUNNEL_FORMAT=prefix
#              -> https://<name>-lt.example.com  (needs *-lt.example.com DNS)
#
# <name> defaults to the client id, is validated as a DNS label, and is locked
# to the client that first claimed it. Set TRUSTED_HOST to the cluster's own
# hostname so its label can never be claimed as a tunnel.
TUNNEL_DOMAIN=
TUNNEL_FORMAT=subdomain
TUNNEL_SCHEME=https
# Extra names nobody may claim (a built-in list already covers www/api/admin/…)
TUNNEL_RESERVED=
TUNNEL_MAX_PER_CLIENT=5
# How long a name stays reserved for its owner after disconnect (0 = release now)
TUNNEL_CLAIM_TTL_HOURS=24

# Socket
# Max size of a single multiplexed frame (bytes). Streaming is chunked, so this
# only needs to cover the largest chunk; a huge value lets one client pin heap.
MAX_HTTP_BUFFER_SIZE=33554432

# Cluster
# Routing is host-sticky: a tunnel host always hashes to the same worker slot,
# so a reconnecting client stays on the worker that keep-alive connections
# are already pinned to.
CLUSTER_ENABLED=true
WORKERS=auto
