# Server endpoints
TRUSTED_HOST=localhost:3000
TRUSTED_SECRET=
PORT=3000

# Log every proxied request (off by default: it is on the hot tunnel path)
REQUEST_LOG=false

# Unified Security
# NODE_ENV=production refuses to start unless SECRET_KEY, ADMIN_PASSWORD and
# ADMIN_JWT_SECRET are all set explicitly.
SECRET_KEY=hlt_default_secret_key_change_me
VERIFY_TOKEN=
# true = anyone can mint a tunnel token from /api/token.
# Defaults to false under NODE_ENV=production; set SERVER_API_KEY when false.
PUBLIC_TOKEN_REGISTRATION=true
SERVER_API_KEY=

# Admin API (separate trust domain — must NOT reuse SECRET_KEY)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_JWT_SECRET=hlt_admin_jwt_secret
ADMIN_JWT_EXPIRES_IN=24h

# Telemetry / Redis
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0

# Socket
# Max size of a single multiplexed frame (bytes). Streaming is chunked, so this
# only needs to cover the largest chunk; a huge value lets one client pin heap.
MAX_HTTP_BUFFER_SIZE=33554432

# Cluster
# Routing is host-sticky: a tunnel host always hashes to the same worker slot,
# so a reconnecting client stays on the worker that keep-alive connections
# are already pinned to.
CLUSTER_ENABLED=true
WORKERS=auto
