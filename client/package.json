{
  "name": "@cubetiq/hlt",
  "version": "0.2.0",
  "description": "A lightweight http tunnel client using nodejs and socket.io client",
  "main": "dist/cli.js",
  "bin": {
    "hlt": "bin/hlt"
  },
  "scripts": {
    "start": "ts-node-dev --respawn --transpile-only src/cli.ts",
    "test": "ts-node-dev --respawn --transpile-only test/test.ts",
    "local": "ts-node-dev --respawn --transpile-only src/cli.ts start -p local",
    "build": "rimraf dist && tsc"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cubetiq/hlt.git"
  },
  "keywords": [
    "http-tunnel-client",
    "socket.io-client"
  ],
  "author": "Sambo Chea <sombochea@cubis.tech>",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.20.0",
    "commander": "^15.0.0",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "https-proxy-agent": "^9.1.0",
    "socket.io-client": "^4.8.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "rimraf": "^6.1.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^7.0.2"
  }
}
