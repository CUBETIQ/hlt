# ==============================================================================
# HLT Server Configuration
# ==============================================================================

# Server Port
PORT=3000

# Trusted host for administrative operations (e.g. backend api routes)
TRUSTED_HOST=localhost:3000
TRUSTED_SECRET=your_trusted_admin_secret_here

# ------------------------------------------------------------------------------
# Cluster & Multi-Worker Settings
# ------------------------------------------------------------------------------
# Set CLUSTER_ENABLED=true to run multiple worker processes in parallel
CLUSTER_ENABLED=true
# Set WORKERS to 'auto' (matches available CPU cores) or a specific integer (e.g., 2, 4, 8)
WORKERS=auto

# ------------------------------------------------------------------------------
# Unified Security & Client Authentication
# ------------------------------------------------------------------------------
# Main Secret Key used to sign and verify tunnel JWT tokens
SECRET_KEY=change_this_to_a_secure_random_secret_in_production
# Optional verification claim check (null or empty string to disable)
VERIFY_TOKEN=

# Allow public token registration via POST /api/token (true/false)
PUBLIC_TOKEN_REGISTRATION=true
# Optional API Key required when PUBLIC_TOKEN_REGISTRATION=false
SERVER_API_KEY=

# ------------------------------------------------------------------------------
# Admin Console API (Protected by Admin JWT)
# ------------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_JWT_SECRET=change_this_to_a_secure_admin_jwt_secret_in_production
ADMIN_JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# Telemetry & Privacy-First Metrics (Redis or In-Memory)
# ------------------------------------------------------------------------------
# If REDIS_ENABLED=true, aggregated counters & metadata are persisted to Redis
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0

# ------------------------------------------------------------------------------
# Socket.io Tuning & Flow Control
# ------------------------------------------------------------------------------
# Maximum HTTP buffer size in bytes (default 500MB: 500000000)
MAX_HTTP_BUFFER_SIZE=500000000
CONCURRENCY_LIMIT=1000
