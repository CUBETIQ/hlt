# ==============================================================================
# HLT Server Configuration
# ==============================================================================

# Server Port
PORT=3000

# Trusted host for administrative operations (e.g. backend api routes)
TRUSTED_HOST=localhost:3000
TRUSTED_SECRET=your_trusted_admin_secret_here

# ------------------------------------------------------------------------------
# Cluster & Multi-Worker Settings
# ------------------------------------------------------------------------------
# Set CLUSTER_ENABLED=true to run multiple worker processes in parallel
CLUSTER_ENABLED=true
# Set WORKERS to 'auto' (matches available CPU cores) or a specific integer (e.g., 2, 4, 8)
WORKERS=auto

# ------------------------------------------------------------------------------
# Security & JWT Tokens
# ------------------------------------------------------------------------------
# Main Secret Key and Verify Token for authenticated tunnel clients
SECRET_KEY=change_this_to_a_secure_random_secret_in_production
VERIFY_TOKEN=change_this_to_a_secure_verify_token_in_production

# Free Tier Access Settings
FREE_ACCESS_TYPE=FREE
FREE_SECRET_KEY=change_this_to_a_secure_free_secret_in_production
FREE_VERIFY_TOKEN=change_this_to_a_secure_free_token_in_production

# Optional credentials for generating JWT tokens via /__backend__/api/get_token
JWT_GENERATOR_USERNAME=admin
JWT_GENERATOR_PASSWORD=change_this_password

# ------------------------------------------------------------------------------
# Redis Adapter (For multi-container or distributed deployments)
# ------------------------------------------------------------------------------
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0

# ------------------------------------------------------------------------------
# Socket.io Tuning & Flow Control
# ------------------------------------------------------------------------------
# Maximum HTTP buffer size in bytes (default 500MB: 500000000)
MAX_HTTP_BUFFER_SIZE=500000000
CONCURRENCY_LIMIT=1000

# ------------------------------------------------------------------------------
# Socket.io Admin UI (Optional)
# ------------------------------------------------------------------------------
ADMIN_ENABLED=false
ADMIN_NAMESPACE=/admin
ADMIN_AUTH_ENABLED=true
ADMIN_AUTH_TYPE=basic
ADMIN_AUTH_USERNAME=admin
# Default bcrypt hash for password '123456'
ADMIN_AUTH_PASSWORD=$2b$10$uLYLbhGW7OnWW6mRye15puPrwzfvSe/WtDLSz8GdLw6FYHxaNlqb2
